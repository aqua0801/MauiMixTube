<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="LightPrimary">#7C3AED</Color>
    <Color x:Key="DarkPrimary">#A78BFA</Color>

    <!-- Primary variants -->
    <Color x:Key="LightPrimaryDim">#5B21B6</Color>
    <Color x:Key="DarkPrimaryDim">#7C3AED</Color>
    <Color x:Key="LightAccent">#EC4899</Color>
    <Color x:Key="DarkAccent">#F472B6</Color>

    <!-- ── Backgrounds ───────────────────────── -->
    <Color x:Key="LightBackground">#F5F3FF</Color>
    <Color x:Key="DarkBackground">#0B0A12</Color>

    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="DarkSurface">#16152A</Color>

    <Color x:Key="LightCard">#FFFFFFCC</Color>
    <Color x:Key="DarkCard">#1E1D35CC</Color>

    <Color x:Key="LightSidebar">#FDFCFF</Color>
    <Color x:Key="DarkSidebar">#100F1E</Color>

    <Color x:Key="LightSidebarItem">#F0EDFF</Color>
    <Color x:Key="DarkSidebarItem">#1E1D35</Color>

    <Color x:Key="LightSidebarItemActive">#EDE9FE</Color>
    <Color x:Key="DarkSidebarItemActive">#2D2B52</Color>

    <!-- ── Text ──────────────────────────────── -->
    <Color x:Key="LightTextPrimary">#1A1830</Color>
    <Color x:Key="DarkTextPrimary">#F0EDFF</Color>

    <Color x:Key="LightTextSecondary">#6B7280</Color>
    <Color x:Key="DarkTextSecondary">#9CA3AF</Color>

    <Color x:Key="LightTextMuted">#C4B5FD</Color>
    <Color x:Key="DarkTextMuted">#4B4870</Color>

    <!-- ── Controls ──────────────────────────── -->
    <Color x:Key="LightSliderTrack">#DDD6FE</Color>
    <Color x:Key="DarkSliderTrack">#2E2B52</Color>

    <Color x:Key="LightIconButton">#227C3AED</Color>
    <Color x:Key="DarkIconButton">#22A78BFA</Color>

    <Color x:Key="LightDivider">#EDE9FE</Color>
    <Color x:Key="DarkDivider">#2A2845</Color>

    <Color x:Key="LightTrackHighlight">#1A7C3AED</Color>
    <Color x:Key="DarkTrackHighlight">#1AA78BFA</Color>

    <!-- ── Overlay ───────────────────────────── -->
    <Color x:Key="SidebarOverlay">#88000000</Color>
    <Color x:Key="GlowColor">#667C3AED</Color>
    <Color x:Key="GlowColorDark">#66A78BFA</Color>

    <!-- ── Always absolute ───────────────────── -->
    <Color x:Key="AlwaysWhite">#FFFFFF</Color>
    <Color x:Key="AlwaysBlack">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

</ResourceDictionary>
